CLANG_WARN_QUOTED_INCLUDE_IN_FRAMEWORK_HEADER = NO
FRAMEWORK_SEARCH_PATHS = $(inherited) "${PODS_CONFIGURATION_BUILD_DIR}/Cache" "${PODS_CONFIGURATION_BUILD_DIR}/CryptoSwift" "${PODS_CONFIGURATION_BUILD_DIR}/DifferenceKit" "${PODS_CONFIGURATION_BUILD_DIR}/Fuzi" "${PODS_CONFIGURATION_BUILD_DIR}/Imaginary" "${PODS_CONFIGURATION_BUILD_DIR}/Lightbox" "${PODS_CONFIGURATION_BUILD_DIR}/Minizip" "${PODS_CONFIGURATION_BUILD_DIR}/MpzReader" "${PODS_CONFIGURATION_BUILD_DIR}/RNCryptor" "${PODS_CONFIGURATION_BUILD_DIR}/ReadiumAdapterGCDWebServer" "${PODS_CONFIGURATION_BUILD_DIR}/ReadiumFuzi" "${PODS_CONFIGURATION_BUILD_DIR}/ReadiumGCDWebServer" "${PODS_CONFIGURATION_BUILD_DIR}/ReadiumInternal" "${PODS_CONFIGURATION_BUILD_DIR}/ReadiumNavigator" "${PODS_CONFIGURATION_BUILD_DIR}/ReadiumShared" "${PODS_CONFIGURATION_BUILD_DIR}/ReadiumStreamer" "${PODS_CONFIGURATION_BUILD_DIR}/ReadiumZIPFoundation" "${PODS_CONFIGURATION_BUILD_DIR}/SQLite.swift" "${PODS_CONFIGURATION_BUILD_DIR}/ScreenProtectorKit" "${PODS_CONFIGURATION_BUILD_DIR}/ScreenShield" "${PODS_CONFIGURATION_BUILD_DIR}/SwiftSoup" "${PODS_CONFIGURATION_BUILD_DIR}/SwiftyJSON" "${PODS_CONFIGURATION_BUILD_DIR}/ZIPFoundation"
GCC_PREPROCESSOR_DEFINITIONS = $(inherited) COCOAPODS=1
HEADER_SEARCH_PATHS = $(inherited) "${PODS_CONFIGURATION_BUILD_DIR}/Cache/Cache.framework/Headers" "${PODS_CONFIGURATION_BUILD_DIR}/CryptoSwift/CryptoSwift.framework/Headers" "${PODS_CONFIGURATION_BUILD_DIR}/DifferenceKit/DifferenceKit.framework/Headers" "${PODS_CONFIGURATION_BUILD_DIR}/Fuzi/Fuzi.framework/Headers" "${PODS_CONFIGURATION_BUILD_DIR}/Imaginary/Imaginary.framework/Headers" "${PODS_CONFIGURATION_BUILD_DIR}/Lightbox/Lightbox.framework/Headers" "${PODS_CONFIGURATION_BUILD_DIR}/Minizip/Minizip.framework/Headers" "${PODS_CONFIGURATION_BUILD_DIR}/MpzReader/MpzReader.framework/Headers" "${PODS_CONFIGURATION_BUILD_DIR}/RNCryptor/RNCryptor.framework/Headers" "${PODS_CONFIGURATION_BUILD_DIR}/ReadiumAdapterGCDWebServer/ReadiumAdapterGCDWebServer.framework/Headers" "${PODS_CONFIGURATION_BUILD_DIR}/ReadiumFuzi/ReadiumFuzi.framework/Headers" "${PODS_CONFIGURATION_BUILD_DIR}/ReadiumGCDWebServer/ReadiumGCDWebServer.framework/Headers" "${PODS_CONFIGURATION_BUILD_DIR}/ReadiumInternal/ReadiumInternal.framework/Headers" "${PODS_CONFIGURATION_BUILD_DIR}/ReadiumNavigator/ReadiumNavigator.framework/Headers" "${PODS_CONFIGURATION_BUILD_DIR}/ReadiumShared/ReadiumShared.framework/Headers" "${PODS_CONFIGURATION_BUILD_DIR}/ReadiumStreamer/ReadiumStreamer.framework/Headers" "${PODS_CONFIGURATION_BUILD_DIR}/ReadiumZIPFoundation/ReadiumZIPFoundation.framework/Headers" "${PODS_CONFIGURATION_BUILD_DIR}/SQLite.swift/SQLite.framework/Headers" "${PODS_CONFIGURATION_BUILD_DIR}/ScreenProtectorKit/ScreenProtectorKit.framework/Headers" "${PODS_CONFIGURATION_BUILD_DIR}/ScreenShield/ScreenShield.framework/Headers" "${PODS_CONFIGURATION_BUILD_DIR}/SwiftSoup/SwiftSoup.framework/Headers" "${PODS_CONFIGURATION_BUILD_DIR}/SwiftyJSON/SwiftyJSON.framework/Headers" "${PODS_CONFIGURATION_BUILD_DIR}/ZIPFoundation/ZIPFoundation.framework/Headers" $(SDKROOT)/usr/include/libxml2
OTHER_LDFLAGS = $(inherited) -l"sqlite3" -l"xml2" -l"z" -framework "AVFoundation" -framework "AVKit" -framework "CFNetwork" -framework "Cache" -framework "CoreServices" -framework "CryptoSwift" -framework "DifferenceKit" -framework "Foundation" -framework "Fuzi" -framework "Imaginary" -framework "Lightbox" -framework "Minizip" -framework "MobileCoreServices" -framework "MpzReader" -framework "RNCryptor" -framework "ReadiumAdapterGCDWebServer" -framework "ReadiumFuzi" -framework "ReadiumGCDWebServer" -framework "ReadiumInternal" -framework "ReadiumNavigator" -framework "ReadiumShared" -framework "ReadiumStreamer" -framework "ReadiumZIPFoundation" -framework "SQLite" -framework "ScreenProtectorKit" -framework "ScreenShield" -framework "SwiftSoup" -framework "SwiftUI" -framework "SwiftyJSON" -framework "UIKit" -framework "ZIPFoundation"
PODS_BUILD_DIR = ${BUILD_DIR}
PODS_CONFIGURATION_BUILD_DIR = ${PODS_BUILD_DIR}/$(CONFIGURATION)$(EFFECTIVE_PLATFORM_NAME)
PODS_PODFILE_DIR_PATH = ${SRCROOT}/.
PODS_ROOT = ${SRCROOT}/Pods
PODS_XCFRAMEWORKS_BUILD_DIR = $(PODS_CONFIGURATION_BUILD_DIR)/XCFrameworkIntermediates
USE_RECURSIVE_SCRIPT_INPUTS_IN_SCRIPT_PHASES = YES
